# Salin menjadi .env (lokal) atau isi di Environment Variables Vercel/Netlify.
# Ambil dari Supabase: Project Settings → API Keys. Isi VITE_SUPABASE_ANON_KEY dengan
# Publishable key (sb_publishable_...) atau, pada project lama, anon public key.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Opsional: tampilkan fitur "Susun dari narasi" (butuh Edge Function generate-steps + ANTHROPIC_API_KEY).
VITE_ENABLE_AI=false
